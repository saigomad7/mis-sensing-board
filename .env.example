# 값을 채운 뒤  cp .env.example .env
# ★.env 는 절대 커밋하지 않는다. .gitignore 에 들어 있다.

# ── ① 임베딩 모델 (필수) — 글을 벡터로 ────────────────────────
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# 예) EMBED_BASE_URL=http://10.x.x.x:8000/v1
#     EMBED_MODEL=bge-m3

# ── ② 생성 모델 (⑦ 답변에만 필요) ─────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── ③ 벡터 저장소 — sqlite | milvus ──────────────────────────
VECTOR_KIND=sqlite
MILVUS_URI=
MILVUS_COLLECTION=mis_chunk
# 인증 — ★사내에 없으면 셋 다 비운다
MILVUS_TOKEN=
MILVUS_USER=
MILVUS_PASSWORD=

# ── ④ 적재 DB · 문서 폴더 ────────────────────────────────────
# 비우면 이 폴더 안(./적재.db, ./문서)
DB_PATH=            # 비우면 ./sensing.db
DOC_DIR=

# ── ⑤ 망 설정 (사내 프록시를 거쳐야 하면) ──────────────────────
HTTP_PROXY=
VERIFY_SSL=1
TIMEOUT=60
